
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Talis Coruja - Cadastro de Instrumentos</title>
</head>
<body>

    <h1>Talis Coruja - Cadastro de Instrumentos Musicais</h1>

    <form action="/instrumento/add" method="POST">

        <label>Nome:</label>
        <input type="text" name="nome" required>
        <br><br>

        <label>Fabricante:</label>
        <input type="text" name="fabricante" required>
        <br><br>

        <label>Preço:</label>
        <input type="number" name="preco" step="0.01" min="0" required>
        <br><br>

        <label>Tipo:</label>
        <input type="text" name="tipo" required>
        <br><br>

        <button type="submit">Cadastrar</button>

    </form>

    <br>
    <a href="/instrumento/lst">Voltar para a listagem</a>

</body>
</html>
